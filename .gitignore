# =============================================
# .gitignore for Culinary Compass Vietnam
# =============================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ----- Virtual Environments -----
venv/
ENV/
env/
.venv/

# ----- IDE / Editor -----
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-workspace
*.sublime-project

# ----- OS Generated -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- Logs -----
*.log
logs/

# ----- Local Config (if any) -----
.env
.env.local
*.local

# ----- Temporary Files -----
*.tmp
*.temp
*.bak

# =============================================
# DO NOT IGNORE (explicitly track these):
# - All HTML, CSS, JS files
# - All JSON data files
# - All images in assets/
# - README.md, STRUCTURE.md
# - app.py, search_api.py
# =============================================

